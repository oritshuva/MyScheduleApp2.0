<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="כותרת המשימה"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- כפתור בחירת תאריך -->
    <Button
        android:id="@+id/btnPickDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="בחר תאריך"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/edtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtChosenDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="לא נבחר תאריך"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/btnPickDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- כפתור בחירת שעה -->
    <Button
        android:id="@+id/btnPickTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="בחר שעה"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtChosenDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtChosenTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="לא נבחרה שעה"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/btnPickTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtDetailsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="תנמק כאן"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtChosenTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/edtDetails"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:hint="פירוט המשימה…"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:textSize="15sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtDetailsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="שמור"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
